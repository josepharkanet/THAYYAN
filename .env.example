# ─────────────────────────────────────────────────────────────
# Stonic Export — environment variables
# Copy to .env for local dev. In Coolify, set these in the app's
# "Environment Variables" tab.
# ─────────────────────────────────────────────────────────────

# SQLite database file. In production this path lives on a persistent
# volume so data survives redeploys (see README / Coolify guide).
#   Local dev:   file:./dev.db
#   Production:  file:/data/stonic.db
DATABASE_URL="file:./dev.db"

# Where uploaded product images are written. In production, point this at
# the same persistent volume.
#   Local dev:   ./public/uploads
#   Production:  /data/uploads
UPLOAD_DIR="./public/uploads"

# Secret used to sign the admin login cookie. MUST be long & random in prod.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"

# Initial admin account, created automatically on first run if absent.
ADMIN_EMAIL="shijo@stonicexport.com"
ADMIN_PASSWORD="change-this-strong-password"
ADMIN_NAME="Shijo Thayyil"

# Public site URL (used for canonical URLs, sitemap, SEO metadata).
NEXT_PUBLIC_SITE_URL="https://www.stonicexport.com"
