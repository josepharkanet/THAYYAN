// Stonic Export — data model
// SQLite keeps the whole app to a single container + one persistent volume.
// Switching to PostgreSQL later is a two-line change (provider + url).

generator client {
  provider      = "prisma-client-js"
  // "native" for local dev (macOS); the debian target matches the Docker image.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Admin users who can sign in to the dashboard (Shijo).
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String   @default("Admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Product categories (Indian Marbles, Granite, …). id is a URL slug.
model Category {
  id          String    @id
  name        String
  description String?
  imageUrl    String?
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([sortOrder])
}

/// A stone product / item shown in the catalogue.
model Product {
  id           String         @id @default(cuid())
  slug         String         @unique
  name         String
  categoryId   String
  category     Category       @relation(fields: [categoryId], references: [id])
  description  String?
  origin       String?
  finish       String?
  thickness    String?
  /// JSON-encoded string array of applications, e.g. ["Flooring","Countertops"].
  applications String?
  imageUrl     String
  gallery      ProductImage[]
  featured     Boolean        @default(false)
  /// Auto-derived: true when any gallery block is marked as available ready stock.
  /// Surfaces the product in the Ready Stock filter/catalogue.
  readyStock   Boolean        @default(false)
  sortOrder    Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([categoryId])
  @@index([featured])
  @@index([readyStock])
  @@index([sortOrder])
}

/// A customer enquiry: a selected list of ready-stock products awaiting an admin price reply.
model Enquiry {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  note      String?
  /// JSON array of items: [{ slug, name, imageUrl, qty }].
  items     String
  status    String   @default("new") // new | quoted | closed
  /// Admin's reply / notes (e.g. itemised prices).
  reply     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

/// Customer feedback / testimonial (text, image or video), moderated from the dashboard.
model Feedback {
  id        String   @id @default(cuid())
  name      String
  location  String?
  /// "text" | "image" | "video"
  type      String   @default("text")
  message   String?
  mediaUrl  String?
  rating    Int?
  approved  Boolean  @default(false)
  featured  Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([approved])
  @@index([sortOrder])
  @@index([createdAt])
}

/// A gallery image for a product. Doubles as a "ready-stock block": when
/// readyStock is on, it represents a specific slab/block currently available,
/// identified by refNo (block number) with an available quantity (qty).
model ProductImage {
  id         Int     @id @default(autoincrement())
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url        String
  /// Unique block / slab number shown to customers (e.g. "AW-101").
  refNo      String?
  /// This specific block is available right now.
  readyStock Boolean @default(false)
  /// Available quantity, free text (e.g. "8 slabs", "450 sq.ft").
  qty        String?
  sortOrder  Int     @default(0)

  @@index([productId])
  @@index([readyStock])
}

/// Editable site content & contact details (key/value), managed from Settings.
model Setting {
  key       String   @id
  value     String?
  updatedAt DateTime @updatedAt
}

/// Homepage "Services" cards, managed from the dashboard.
model Service {
  id          String   @id @default(cuid())
  icon        String   @default("mountain")
  subtitle    String
  title       String
  description String
  imageUrl    String
  /// JSON string array of highlight bullets.
  highlights  String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
}

/// "Why choose us" value props, managed from the dashboard.
model Value {
  id          String   @id @default(cuid())
  icon        String   @default("gem")
  title       String
  description String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
}

/// Completed projects / installations shown on the "Works" page.
model Work {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  /// e.g. "Flooring", "Landscaping", "Cladding", "Paving".
  category    String   @default("")
  location    String?
  year        String?
  description String?
  imageUrl    String
  /// JSON-encoded string array of extra gallery image URLs.
  gallery     String?
  featured    Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
  @@index([featured])
}

/// Blog / journal articles (SEO content), managed from the dashboard.
model Post {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String?
  /// Article body in Markdown.
  content     String
  coverImage  String?
  /// Comma-separated SEO keywords.
  keywords    String?
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published])
  @@index([publishedAt])
}
